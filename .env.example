# Dify Plugin SDK environment configuration
# Copy this file to .env and replace the placeholder key.

# Use remote mode when attaching source code to the Dify plugin daemon.
INSTALL_METHOD=remote
REMOTE_INSTALL_HOST=localhost
REMOTE_INSTALL_PORT=5003
REMOTE_INSTALL_KEY=replace-with-your-dify-debug-key

# Optional SDK settings.
MAX_REQUEST_TIMEOUT=300
MAX_INVOCATION_TIMEOUT=250
HEARTBEAT_INTERVAL=10
DIFY_PLUGIN_DAEMON_URL=http://localhost:5002
HTTPX_TIMEOUT=5
